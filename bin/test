#!/usr/bin/env bash
# Hanaseru の試験を全部回す1本（exit 0=全部成功 / 1=失敗あり）。公開の前に必ず通す。
#   単体（node --test）＋ブラウザ（Playwright：Chrome と WebKit mobile）。AI・ログイン・マイクは模擬で、実iPhoneの確認ではない。
#   Playwright は NODE_PATH で渡す（既定＝~/.cache/hanaseru-validation/node_modules）。本番に対して回すときは HANASERU_TEST_URL を渡す。
set -u
cd "$(dirname "$0")/.."
export NODE_PATH="${NODE_PATH:-$HOME/.cache/hanaseru-validation/node_modules}"
ng=0; started=""
if [ -z "${HANASERU_TEST_URL:-}" ] && ! curl -s -o /dev/null http://127.0.0.1:8087/; then
  python3 -m http.server 8087 --bind 127.0.0.1 >/dev/null 2>&1 & started=$!; sleep 1
fi
for f in *.js functions/index.js functions/speech.js; do node --check "$f" || ng=1; done
for t in tests/*.test.cjs; do
  if node --test "$t" >/dev/null 2>&1; then printf '  ✅ %s\n' "$t"; else printf '  ❌ %s\n     → node --test %s\n' "$t" "$t"; ng=1; fi
done
if [ -z "${HANASERU_TEST_URL:-}" ]; then browser=$(ls tests/*-browser.cjs tests/browser-smoke.cjs tests/listening-audio-webkit.cjs tests/audio-ios-policy.cjs)
else browser="tests/audio-ios-policy.cjs tests/consult-browser.cjs"; fi   # 本番には、模擬だけで完結する2本を回す
for t in $browser; do
  ok=0; for try in 1 2; do timeout 240 node "$t" >/tmp/hanaseru-test.log 2>&1 && { ok=1; break; }; done   # 試験用サーバーの接続切れに備えて2回まで
  if [ $ok = 1 ]; then printf '  ✅ %s\n' "$t"; else printf '  ❌ %s\n     → NODE_PATH=%s node %s\n' "$t" "$NODE_PATH" "$t"; grep -v '^\s*at ' /tmp/hanaseru-test.log | tail -4 | sed 's/^/       /'; ng=1; fi
done
[ -n "$started" ] && kill "$started" 2>/dev/null
[ $ng = 0 ] && echo "→ 試験はすべて成功" || echo "→ 失敗あり"
exit $ng
