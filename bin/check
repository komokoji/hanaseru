#!/usr/bin/env bash
# Hanaseru 点検 — 「ちゃんと動いている？」に記憶で答えないための1本（exit 0=OK / 1=要対応）
#   ① 本番サイトが開く  ② Firebase CLI のログインが生きている（デプロイできる）
#   ③ Firestore ルールに Hanaseru の枠がある（clinic-ops が正本）  ④ Polaris が読む要約が公開で取れる
#   ⑤ AI会話の Functions が応答する（未デプロイなら要対応として出す）
set -u
cd "$(dirname "$0")/.."
export PATH="$HOME/.npm-global/bin:/opt/homebrew/bin:$PATH"   # firebase が PATH に無いと「ログイン切れ」と誤って出るため
ng=0
ok()  { printf '  ✅ %s\n' "$1"; }
bad() { printf '  ❌ %s\n     → %s\n' "$1" "$2"; ng=1; }

echo "🗣 Hanaseru 点検（$(date '+%Y-%m-%d %H:%M')）"

code=$(curl -s -o /dev/null -w '%{http_code}' https://hanaseru.web.app/ || echo 000)
[ "$code" = 200 ] && ok "本番 https://hanaseru.web.app が開く" || bad "本番サイトが $code" "firebase deploy --only hosting"

if firebase projects:list >/dev/null 2>&1; then ok "Firebase CLI ログイン有効"
else bad "Firebase CLI のログインが切れている（デプロイ不可）" "firebase login --reauth"; fi

rules=../clinic-ops/firestore.rules
if grep -q "hanaseru_public" "$rules" 2>/dev/null; then ok "Firestore ルールに Hanaseru の枠がある（clinic-ops/firestore.rules）"
else bad "ルールに Hanaseru の枠がない" "clinic-ops/firestore.rules に hanaseru_users / hanaseru_public を追加"; fi

sum=$(curl -s -o /dev/null -w '%{http_code}' "https://firestore.googleapis.com/v1/projects/komori-clinic-platform/databases/(default)/documents/hanaseru_public/summary" || echo 000)
case "$sum" in
  200) ok "Polaris 用の要約（hanaseru_public/summary）が公開で読める" ;;
  404) bad "ルールは通っているが、まだ1回も同期していない" "アプリで Google ログイン → 1セッション完了" ;;
  403) bad "要約が公開になっていない（ルール未反映）" "cd ~/Developer/clinic-ops && firebase deploy --only firestore:rules" ;;
  *)   bad "要約の取得が $sum" "ネットワーク／Firestore を確認" ;;
esac

fn=$(curl -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' -d '{"data":{}}' https://asia-northeast1-komori-clinic-platform.cloudfunctions.net/hanaseruChat || echo 000)
case "$fn" in
  401|400) ok "AI会話の Functions（hanaseruChat）が応答する（未ログインは弾く）" ;;
  404|000) bad "AI会話の Functions が未デプロイ" "cd ~/Developer/hanaseru && firebase deploy --only functions" ;;
  *)   bad "hanaseruChat が $fn" "firebase functions:log --only hanaseruChat" ;;
esac

if node -e "global.window={};['data','trip','visit','gutnutri','me','basics','parts','listen'].forEach(f=>require('./'+f+'.js'));const ix={};window.HANASERU_CARDS.forEach(c=>ix[c.id]=(ix[c.id]||0)+1);const P=window.HANASERU_PART_BY_ID;const bad=Object.keys(ix).filter(k=>ix[k]>1).concat(window.HANASERU_PARTS.flatMap(p=>p.ids.filter(i=>!ix[i])),window.HANASERU_FLOWS.flatMap(f=>f.parts).concat(window.HANASERU_CASES.flatMap(k=>k.model)).filter(p=>!P[p]));if(bad.length){console.log(bad.join(' '));process.exit(1)}" >/dev/null 2>&1; then ok "辞書・部品・流れ・症例のつながり（id の重複・参照切れなし）"
else bad "辞書・部品・流れ・症例のどこかで id が重複／参照切れ" "bin/check の該当行の node -e を手で実行して、出た id を直す"; fi

if node functions/selftest.js >/dev/null 2>&1; then ok "AI の型の自己点検（functions/selftest.js）"
else bad "AI の型の自己点検が NG（どこかのモードが壊れている）" "node functions/selftest.js"; fi

# 音声（v70〜）：版の表示・公開版・手本のMP3・ログインの戻り先
local_v=$(sed -n 's/.*CACHE = "hanaseru-\(v[0-9]*\)".*/\1/p' sw.js)
if grep -q "最新版を読み込む（${local_v}）" index.html; then ok "版の表示がそろっている（sw.js と メニュー＝${local_v}）"
else bad "sw.js の版（${local_v}）とメニューの表示が違う" "index.html の「最新版を読み込む（v◯）」を ${local_v} に直す"; fi
prod_v=$(curl -s https://hanaseru.web.app/sw.js | sed -n 's/.*CACHE = "hanaseru-\(v[0-9]*\)".*/\1/p')
[ "$prod_v" = "$local_v" ] && ok "本番が手元と同じ版（${local_v}）" || bad "本番は ${prod_v:-不明}・手元は ${local_v}（未公開）" "firebase login --reauth のあと firebase deploy --only hosting"
if node -e "global.self=global;require('./card-audio.js');require('./listening-audio.js');const fs=require('fs');const m=Object.assign({},self.HANASERU_CARD_AUDIO,self.HANASERU_LISTENING_AUDIO);const c=Object.keys(self.HANASERU_CARD_AUDIO).length;const miss=Object.values(m).filter(f=>!fs.existsSync(f));if(!c||miss.length){console.log(c,miss.length);process.exit(1)}" >/dev/null 2>&1; then ok "手本のMP3（カード・場面・聞き取り）が作成済みで、ファイルがそろっている"
else bad "手本のMP3が未作成、または足りない（未ログインのiPhoneでは端末の読み上げになる）" "firebase login --reauth のあと node ops/build-card-audio.cjs"; fi
if node -e "global.window=global;global.self=global;require('./card-audio.js');['scenes-data','personal-scenes','clinic-dialogues','clinic-dialogues-constipation','clinic-dialogues-respiratory','clinic-dialogues-nutrition'].forEach(f=>require('./'+f+'.js'));const m=self.HANASERU_CARD_AUDIO,n=t=>String(t).trim(),bad=[];const html=require('fs').readFileSync('index.html','utf8'),sw=require('fs').readFileSync('sw.js','utf8');require('fs').readdirSync('.').filter(f=>/^clinic-dialogues.*\\.js$/.test(f)).forEach(f=>{if(!html.includes('\"'+f+'\"')||!sw.includes('./'+f))bad.push('未登録:'+f)});window.HANASERU_CONSULT_SCENES.forEach(s=>{if(!s.source||!s.group||!s.voices)bad.push('meta:'+s.id);s.turns.concat([s.challenge]).forEach(t=>{if(!m[n(t.heard)]||!m[n(t.en)])bad.push('音声なし:'+s.id)});if(!m[n(s.turns.map(t=>t.heard+' '+t.en).join(' '))])bad.push('通しなし:'+s.id)});if(bad.length){console.log([...new Set(bad)].join(' '));process.exit(1)}" >/dev/null 2>&1; then ok "🩺 診察の会話（すべてに出典・声・公開済みMP3があり、index.html と sw.js に登録済み）"
else bad "診察の会話に、出典・音声・登録のどれかが欠けている" "node ops/build-card-audio.cjs（音声）／index.html と sw.js に clinic-dialogues-*.js を1行ずつ（README「診察の会話を足す」）"; fi
if node -e "global.window=global;global.self=global;global.HANASERU_SCENES=[];['card-audio','connector-drills','dubai-scenes','phrasal-verbs','assess-data'].forEach(f=>require('./'+f+'.js'));const m=self.HANASERU_CARD_AUDIO,n=t=>String(t).trim(),bad=[];HANASERU_PHRASALS.forEach(x=>{if(!m[n(x.en)])bad.push(x.id)});HANASERU_ASSESS.forms.forEach(f=>{f.listening.forEach(x=>{if(!m[n(x.en)]||x.options.length!==4)bad.push(x.id)});f.speaking.forEach(x=>{if(!m[n(x.promptEn)])bad.push(x.id)})});HANASERU_LINK_SCENES.concat(HANASERU_DUBAI_SCENES).forEach(s=>s.turns.concat([s.challenge]).forEach(t=>{if(!m[n(t.heard)]||!m[n(t.en)])bad.push(s.id)}));if(HANASERU_PHRASALS.length<60||HANASERU_ASSESS.forms.length<3||bad.length){console.log(bad.join(' '));process.exit(1)}" >/dev/null 2>&1; then ok "🧩 熟語・🔗 つなぎ・🎤 ドバイ・📏 現在地チェック（すべての英文に公開済みMP3がある）"
else bad "熟語・つなぎ・ドバイ・現在地チェックのどれかに、音声の無い英文がある" "node ops/build-card-audio.cjs"; fi
auth=$(curl -s -o /dev/null -w '%{http_code}' https://hanaseru.web.app/__/auth/handler || echo 000)
[ "$auth" = 200 ] && ok "ログインの戻り先（hanaseru.web.app/__/auth/handler）が開く" || bad "ログインの戻り先が $auth" "Firebase Hosting の公開先と authDomain（cloud.js）を確認"

# ⑦ 作者の印（AGENTS.md）：2026-10-01 以降、定期バックアップに作者不明のコードが混ざっていないか
git fetch -q origin 'refs/notes/*:refs/notes/*' 2>/dev/null
unmarked=""
for h in $(git log --no-merges --since=2026-10-01 --format=%h); do
  msg=$(git log -1 --format=%B "$h"); note=$(git notes show "$h" 2>/dev/null)
  printf '%s\n%s' "$msg" "$note" | grep -qE '^(AI-Agent:|Co-Authored-By: Claude)' && continue
  printf '%s' "$msg" | grep -q '定期バックアップ' && unmarked="$unmarked $h"
done
[ -z "$unmarked" ] && ok "作者の印（Claude／Codex／院長の手が区別できる）" \
  || bad "作者の印がない定期バックアップ:$unmarked（AI の変更が拾われた可能性）" "git show --stat <commit> で中身を見て、git notes add -m \"AI-Agent: …\" <commit> → git push origin refs/notes/commits"

[ $ng = 0 ] && echo "→ すべてOK" || echo "→ 要対応あり"
exit $ng
